      <memberdef kind="function" id="LL__table_8c_1aa80a09989199a6a40c140c08b12f5ec9" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>const <ref refid="structLLTableEntry" kindref="compound">LLTableEntry</ref> *</type>
        <definition>const LLTableEntry * ll_table_lookup</definition>
        <argsstring>(NonterminalType nonterm, TokenType terminal, int line)</argsstring>
        <name>ll_table_lookup</name>
        <param>
          <type><ref refid="nonterminal_8h_1a85d4bc22c0246920638f94d69fe381dd" kindref="member">NonterminalType</ref></type>
          <declname>nonterm</declname>
        </param>
