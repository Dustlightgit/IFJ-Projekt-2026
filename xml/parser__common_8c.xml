<parameternamelist>
<parametername>is_predictive_parser</parametername>
</parameternamelist>
<parameterdescription>
<para>True pro pravidlo prediktivniho (LL) parseru, false pro pravidlo precedencniho parseru. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>rule_number</parametername>
</parameternamelist>
<parameterdescription>
<para>Cislo pravidla. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>line</parametername>
</parameternamelist>
<parameterdescription>
<para>Cislo radku vstupu. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
