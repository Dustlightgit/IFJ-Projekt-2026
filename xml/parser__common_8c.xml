        <argsstring>(bool is_predictive_parser, int rule_number, int line)</argsstring>
        <name>trace_rule</name>
        <param>
          <type>bool</type>
          <declname>is_predictive_parser</declname>
        </param>
        <param>
          <type>int</type>
